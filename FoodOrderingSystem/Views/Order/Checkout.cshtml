@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-5">
    <!-- Page Heading -->
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-3">
            <i class="bi bi-bag-check-fill me-1"></i>
            Secure Checkout
        </span>

        <h1 class="fw-bold mb-2">Complete Your Order</h1>

        <p class="text-muted mb-0">
            Enter your delivery details and place your order
        </p>
    </div>


    <div class="row g-4 justify-content-center">

        <!-- Delivery Details -->
        <div class="col-lg-7">

            <div class="card border-0 shadow-lg rounded-4 h-100">

                <div class="card-header bg-dark text-white p-4 rounded-top-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-warning text-dark rounded-circle
                            d-flex align-items-center justify-content-center
                            me-3"
                             style="width: 50px; height: 50px;">

                            <i class="bi bi-truck fs-4"></i>

                        </div>

                        <div>
                            <h4 class="mb-1 fw-bold">
                                Delivery Details
                            </h4>

                            <small class="text-white-50">
                                Where should we deliver your order?
                            </small>
                        </div>

                    </div>

                </div>


                <div class="card-body p-4 p-md-5">

                    <form action="/Order/Checkout" method="post">

                        <!-- Address -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                <i class="bi bi-geo-alt-fill text-danger me-2"></i>
                                Delivery Address
                            </label>

                            <textarea name="deliveryAddress"
                                      class="form-control form-control-lg"
                                      rows="4"
                                      placeholder="Enter your complete delivery address..."
                                      required></textarea>

                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                Please provide house number, street, area and city.
                            </div>

                        </div>


                        <!-- Phone -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                <i class="bi bi-telephone-fill text-success me-2"></i>
                                Phone Number
                            </label>

                            <input type="tel"
                                   name="phoneNumber"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your phone number"
                                   autocomplete="tel"
                                   required />

                            <div class="form-text">
                                We'll use this number to contact you regarding your delivery.
                            </div>

                        </div>


                        <!-- Payment Method -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                <i class="bi bi-wallet2 text-primary me-2"></i>
                                Payment Method
                            </label>

                            <div class="card border rounded-3">

                                <div class="card-body d-flex align-items-center">

                                    <div class="bg-success-subtle text-success rounded-3
                                        d-flex align-items-center justify-content-center
                                        me-3"
                                         style="width: 45px; height: 45px;">

                                        <i class="bi bi-cash-coin fs-4"></i>

                                    </div>

                                    <div class="flex-grow-1">

                                        <h6 class="mb-1 fw-bold">
                                            Cash on Delivery
                                        </h6>

                                        <small class="text-muted">
                                            Pay when your food arrives
                                        </small>

                                    </div>

                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>

                                </div>

                            </div>

                        </div>


                        <!-- Terms -->
                        <div class="form-check mb-4">

                            <input class="form-check-input"
                                   type="checkbox"
                                   id="terms"
                                   required />

                            <label class="form-check-label small text-muted"
                                   for="terms">

                                I confirm that my delivery details are correct
                                and I agree to place this order.

                            </label>

                        </div>


                        <!-- Place Order -->
                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 fw-bold py-3">

                            <i class="bi bi-check-circle-fill me-2"></i>
                            Place Order

                        </button>

                    </form>

                </div>

            </div>

        </div>


        <!-- Order Summary -->
        <div class="col-lg-5">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-header bg-primary text-white p-4 rounded-top-4">

                    <div class="d-flex align-items-center">

                        <i class="bi bi-receipt-cutoff fs-3 me-3"></i>

                        <div>
                            <h4 class="mb-0 fw-bold">
                                Order Summary
                            </h4>

                            <small class="text-white-50">
                                Your order total
                            </small>
                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <!-- Total -->
                    <div class="text-center py-4">

                        <div class="text-muted small mb-2">
                            TOTAL AMOUNT
                        </div>

                        <h1 class="display-5 fw-bold text-primary mb-0">
                            $@ViewBag.Total
                        </h1>

                        <span class="badge bg-success-subtle text-success mt-2">
                            <i class="bi bi-check-circle me-1"></i>
                            Ready to Order
                        </span>

                    </div>


                    <hr />


                    <!-- Summary Items -->
                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            <i class="bi bi-basket me-2"></i>
                            Food Items
                        </span>

                        <span class="fw-semibold">
                            Included
                        </span>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            <i class="bi bi-truck me-2"></i>
                            Delivery
                        </span>

                        <span class="text-success fw-semibold">
                            Included
                        </span>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            <i class="bi bi-wallet2 me-2"></i>
                            Payment
                        </span>

                        <span class="fw-semibold">
                            Cash on Delivery
                        </span>

                    </div>


                    <hr />


                    <!-- Final Total -->
                    <div class="d-flex justify-content-between align-items-center">

                        <span class="fw-bold fs-5">
                            Total
                        </span>

                        <span class="fw-bold fs-4 text-primary">
                            $@ViewBag.Total
                        </span>

                    </div>

                </div>

            </div>


            <!-- Security Card -->
            <div class="card border-0 bg-light rounded-4 mt-4">

                <div class="card-body p-4">

                    <div class="d-flex">

                        <i class="bi bi-shield-check-fill text-success fs-3 me-3"></i>

                        <div>

                            <h6 class="fw-bold mb-1">
                                Safe & Secure
                            </h6>

                            <p class="text-muted small mb-0">
                                Your personal information is kept secure
                                and is only used to process your order.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
    

</div>
