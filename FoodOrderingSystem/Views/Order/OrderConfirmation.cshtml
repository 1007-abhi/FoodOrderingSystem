@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container py-5">
    <div class="row justify-content-center">

        <div class="col-12 col-md-9 col-lg-7">

            <!-- Success Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-success text-white text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-check-circle-fill display-1"></i>
                    </div>

                    <h1 class="fw-bold mb-2">
                        Order Confirmed!
                    </h1>

                    <p class="mb-0 fs-5">
                        Your delicious food is on its way 🍔
                    </p>

                </div>


                <!-- Body -->
                <div class="card-body text-center p-4 p-md-5">

                    <h4 class="fw-bold mb-2">
                        Thank you for your order!
                    </h4>

                    <p class="text-muted mb-4">
                        We've received your order and our restaurant
                        is getting it ready for you.
                    </p>


                    <!-- Order ID -->
                    <div class="bg-light rounded-4 p-4 mb-4">

                        <div class="text-muted small text-uppercase fw-semibold mb-2">
                            Your Order ID
                        </div>

                        <div class="d-flex justify-content-center align-items-center gap-2">

                            <i class="bi bi-receipt-cutoff text-success fs-4"></i>

                            <span class="fs-3 fw-bold text-dark">
                                #@ViewBag.OrderId
                            </span>

                        </div>

                    </div>


                    <!-- Order Status -->
                    <div class="row g-3 mb-4">

                        <div class="col-4">

                            <div class="text-success">
                                <i class="bi bi-check-circle-fill fs-3"></i>
                            </div>

                            <small class="fw-semibold d-block mt-2">
                                Order Placed
                            </small>

                            <small class="text-muted">
                                Done
                            </small>

                        </div>


                        <div class="col-4">

                            <div class="text-warning">
                                <i class="bi bi-fire fs-3"></i>
                            </div>

                            <small class="fw-semibold d-block mt-2">
                                Preparing
                            </small>

                            <small class="text-muted">
                                Next
                            </small>

                        </div>


                        <div class="col-4">

                            <div class="text-secondary">
                                <i class="bi bi-bicycle fs-3"></i>
                            </div>

                            <small class="fw-semibold d-block mt-2">
                                Delivered
                            </small>

                            <small class="text-muted">
                                Coming soon
                            </small>

                        </div>

                    </div>


                    <hr class="my-4">


                    <!-- Delivery Information -->
                    <div class="alert alert-info border-0 rounded-4 text-start">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-clock-history fs-3 me-3"></i>

                            <div>

                                <h6 class="fw-bold mb-1">
                                    Estimated Delivery
                                </h6>

                                <p class="mb-0 small">
                                    Your order will be delivered as soon
                                    as it is freshly prepared.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- Buttons -->
                    <div class="d-grid gap-2 d-md-flex justify-content-center mt-4">

                        <a asp-controller="Order"
                           asp-action="MyOrders"
                           class="btn btn-primary btn-lg px-4">

                            <i class="bi bi-bag-check-fill me-2"></i>
                            View My Orders

                        </a>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary btn-lg px-4">

                            <i class="bi bi-house-fill me-2"></i>
                            Continue Ordering

                        </a>

                    </div>

                </div>


                <!-- Footer -->
                <div class="card-footer bg-light border-0 text-center py-3">

                    <small class="text-muted">

                        <i class="bi bi-heart-fill text-danger me-1"></i>

                        Thank you for choosing us for your meal!

                    </small>

                </div>

            </div>

        </div>

    </div>
   

</div>
