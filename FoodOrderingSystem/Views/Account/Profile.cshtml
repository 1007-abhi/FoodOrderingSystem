@model FoodOrderingSystem.Dto.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="bg-light min-vh-100 py-5">

    <div class="container">

        <!-- =========================
             PAGE HEADER
        ========================== -->
        <div class="mb-4">

            <h2 class="fw-bold mb-1">
                <i class="bi bi-person-circle text-danger me-2"></i>
                My Profile
            </h2>

            <p class="text-muted mb-0">
                Manage your personal information and account settings
            </p>

        </div>


        <!-- =========================
             ALERT MESSAGES
        ========================== -->

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"></i>

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3"
                 role="alert">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <div class="row g-4">

            <!-- =========================
                 PROFILE SIDEBAR
            ========================== -->
            <div class="col-lg-4">

                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                    <!-- Profile Header -->
                    <div class="bg-dark text-white text-center p-4">

                        <div class="bg-danger rounded-circle
                                    d-flex align-items-center
                                    justify-content-center
                                    mx-auto mb-3 shadow"
                             style="width:100px;height:100px;">

                            <span class="display-5 fw-bold">
                                @(string.IsNullOrEmpty(Model.FullName)
                                    ? "U"
                                    : Model.FullName.Substring(0, 1).ToUpper())
                            </span>

                        </div>


                        <h4 class="fw-bold mb-1">
                            @Model.FullName
                        </h4>

                        <p class="text-white-50 mb-3">
                            @Model.Username
                        </p>


                        <span class="badge bg-success rounded-pill px-3 py-2">

                            <i class="bi bi-check-circle-fill me-1"></i>
                            Active Member

                        </span>

                    </div>


                    <!-- Profile Information -->
                    <div class="card-body p-4">

                        <h6 class="fw-bold mb-3">
                            Account Information
                        </h6>


                        <!-- Username -->
                        <div class="d-flex align-items-center mb-3">

                            <div class="bg-danger bg-opacity-10
                                        text-danger rounded-3
                                        d-flex align-items-center
                                        justify-content-center me-3"
                                 style="width:42px;height:42px;">

                                <i class="bi bi-person"></i>

                            </div>

                            <div>

                                <small class="text-muted d-block">
                                    Username
                                </small>

                                <span class="fw-semibold">
                                    @Model.Username
                                </span>

                            </div>

                        </div>


                        <!-- Email -->
                        <div class="d-flex align-items-center mb-3">

                            <div class="bg-danger bg-opacity-10
                                        text-danger rounded-3
                                        d-flex align-items-center
                                        justify-content-center me-3"
                                 style="width:42px;height:42px;">

                                <i class="bi bi-envelope"></i>

                            </div>

                            <div class="text-truncate">

                                <small class="text-muted d-block">
                                    Email
                                </small>

                                <span class="fw-semibold">
                                    @Model.Email
                                </span>

                            </div>

                        </div>


                        <!-- Phone -->
                        <div class="d-flex align-items-center mb-3">

                            <div class="bg-danger bg-opacity-10
                                        text-danger rounded-3
                                        d-flex align-items-center
                                        justify-content-center me-3"
                                 style="width:42px;height:42px;">

                                <i class="bi bi-telephone"></i>

                            </div>

                            <div>

                                <small class="text-muted d-block">
                                    Phone
                                </small>

                                <span class="fw-semibold">
                                    @Model.Phone
                                </span>

                            </div>

                        </div>


                        <!-- Address -->
                        <div class="d-flex align-items-start">

                            <div class="bg-danger bg-opacity-10
                                        text-danger rounded-3
                                        d-flex align-items-center
                                        justify-content-center me-3"
                                 style="width:42px;height:42px;">

                                <i class="bi bi-geo-alt"></i>

                            </div>

                            <div>

                                <small class="text-muted d-block">
                                    Delivery Address
                                </small>

                                <span class="fw-semibold">
                                    @Model.Address
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Quick Links -->
                <div class="card border-0 shadow-sm rounded-4 mt-4">

                    <div class="card-body p-3">

                        <a asp-controller="Menu"
                           asp-action="Index"
                           class="btn btn-light w-100 text-start mb-2">

                            <i class="bi bi-shop text-danger me-2"></i>
                            Browse Menu

                            <i class="bi bi-chevron-right float-end"></i>

                        </a>


                        <a asp-controller="Order"
                           asp-action="Index"
                           class="btn btn-light w-100 text-start mb-2">

                            <i class="bi bi-bag-check text-danger me-2"></i>
                            My Orders

                            <i class="bi bi-chevron-right float-end"></i>

                        </a>
                        <a href="/Account/ChangePassword"
                           class="btn btn-light w-100 text-start">

                            <i class="bi bi-key-fill text-danger me-2"></i>
                            Change Password

                            <i class="bi bi-chevron-right float-end"></i>

                        </a>
                    </div>

                </div>

            </div>


            <!-- =========================
                 EDIT PROFILE
            ========================== -->
            <div class="col-lg-8">

                <div class="card border-0 shadow-sm rounded-4">

                    <!-- Card Header -->
                    <div class="card-header bg-white border-0 p-4">

                        <div class="d-flex align-items-center">

                            <div class="bg-danger bg-opacity-10
                                        text-danger rounded-3
                                        d-flex align-items-center
                                        justify-content-center me-3"
                                 style="width:48px;height:48px;">

                                <i class="bi bi-pencil-square fs-5"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-1">
                                    Edit Profile
                                </h5>

                                <small class="text-muted">
                                    Update your personal information
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body p-4">


                        <form asp-action="Profile" method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>


                            <input type="hidden" asp-for="Id" />

                            <input type="hidden"
                                   asp-for="Username" />


                            <!-- Username -->
                            <div class="mb-4">

                                <label class="form-label fw-semibold">
                                    Username
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">

                                        <i class="bi bi-person text-danger"></i>

                                    </span>

                                    <input asp-for="Username"
                                           class="form-control form-control-lg bg-light"
                                           disabled />

                                </div>

                                <small class="text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Username cannot be changed
                                </small>

                            </div>


                            <div class="row">

                                <!-- Full Name -->
                                <div class="col-md-6 mb-4">

                                    <label asp-for="FullName"
                                           class="form-label fw-semibold">
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text bg-light">

                                            <i class="bi bi-person-vcard text-danger"></i>

                                        </span>

                                        <input asp-for="FullName"
                                               class="form-control form-control-lg"
                                               placeholder="Enter your full name" />

                                    </div>

                                    <span asp-validation-for="FullName"
                                          class="text-danger small">
                                    </span>

                                </div>


                                <!-- Email -->
                                <div class="col-md-6 mb-4">

                                    <label asp-for="Email"
                                           class="form-label fw-semibold">
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text bg-light">

                                            <i class="bi bi-envelope text-danger"></i>

                                        </span>

                                        <input asp-for="Email"
                                               class="form-control form-control-lg"
                                               placeholder="Enter your email" />

                                    </div>

                                    <span asp-validation-for="Email"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>


                            <!-- Phone -->
                            <div class="mb-4">

                                <label asp-for="Phone"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">

                                        <i class="bi bi-telephone text-danger"></i>

                                    </span>

                                    <input asp-for="Phone"
                                           class="form-control form-control-lg"
                                           placeholder="Enter your phone number" />

                                </div>

                                <span asp-validation-for="Phone"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Address -->
                            <div class="mb-4">

                                <label asp-for="Address"
                                       class="form-label fw-semibold">

                                    Delivery Address

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light align-items-start pt-3">

                                        <i class="bi bi-geo-alt text-danger"></i>

                                    </span>

                                    <textarea asp-for="Address"
                                              class="form-control form-control-lg"
                                              rows="3"
                                              placeholder="Enter your complete delivery address">
                                    </textarea>

                                </div>

                                <span asp-validation-for="Address"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Save -->
                            <div class="d-flex justify-content-end">

                                <button type="submit"
                                        class="btn btn-danger btn-lg rounded-pill px-5">

                                    <i class="bi bi-check2-circle me-2"></i>
                                    Save Changes

                                </button>

                            </div>

                        </form>

                    </div>

                </div>


                <!-- =========================
                     ACCOUNT SECURITY
                ========================== -->
                <div class="card border-0 shadow-sm rounded-4 mt-4">

                    <div class="card-body p-4">

                        <div class="d-flex align-items-center">

                            <div class="bg-success bg-opacity-10
                                        text-success rounded-3
                                        d-flex align-items-center
                                        justify-content-center me-3"
                                 style="width:48px;height:48px;">

                                <i class="bi bi-shield-check fs-5"></i>

                            </div>

                            <div>

                                <h6 class="fw-bold mb-1">
                                    Your Account is Secure
                                </h6>

                                <p class="text-muted small mb-0">
                                    Keep your account information up to date
                                    for a better ordering experience.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =========================
                     DANGER ZONE
                ========================== -->
                <div class="card border-0 shadow-sm rounded-4 mt-4">

                    <div class="card-body p-4">

                        <h6 class="fw-bold text-danger mb-2">

                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Danger Zone

                        </h6>

                        <p class="text-muted small">
                            Deleting your account is permanent and cannot
                            be undone.
                        </p>


                        <button type="button"
                                class="btn btn-outline-danger rounded-pill"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteAccountModal">

                            <i class="bi bi-trash3 me-2"></i>
                            Delete Account

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================
     DELETE ACCOUNT MODAL
========================= -->

<div class="modal fade"
     id="deleteAccountModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <!-- Header -->
            <div class="modal-header bg-danger text-white border-0 px-4 py-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white bg-opacity-25 rounded-circle p-2">
                        <i class="bi bi-person-x-fill fs-4"></i>
                    </div>

                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="deleteModalLabel">
                            Delete Account
                        </h5>
                        <small class="text-white-50">
                            This action requires your confirmation
                        </small>
                    </div>
                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body p-4">

                <!-- Warning -->
                <div class="alert alert-danger border-0 rounded-3 d-flex align-items-start gap-3 mb-4">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>

                    <div>
                        <h6 class="fw-bold mb-1">
                            Are you absolutely sure?
                        </h6>

                        <p class="mb-0 small">
                            Deleting your account is permanent and cannot be undone.
                        </p>
                    </div>
                </div>

                <p class="text-dark mb-3">
                    If you continue, the following information will be permanently deleted:
                </p>

                <!-- What will be deleted -->
                <div class="bg-light rounded-3 p-3 mb-4">

                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-person-fill text-danger me-3"></i>
                        <span>Account and profile information</span>
                    </div>

                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-receipt text-danger me-3"></i>
                        <span>Order history and order information</span>
                    </div>

                    <div class="d-flex align-items-center">
                        <i class="bi bi-heart-fill text-danger me-3"></i>
                        <span>Saved preferences and account data</span>
                    </div>

                </div>

                <div class="text-center">
                    <small class="text-muted">
                        <i class="bi bi-shield-exclamation me-1"></i>
                        Once deleted, your account cannot be recovered.
                    </small>
                </div>

            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 bg-light px-4 py-3">

                <button type="button"
                        class="btn btn-outline-secondary rounded-pill px-4"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>
                    Cancel
                </button>

                <form asp-action="DeleteAccount"
                      method="post"
                      class="m-0">

                    <button type="submit"
                            class="btn btn-danger rounded-pill px-4 fw-semibold">
                        <i class="bi bi-trash3-fill me-1"></i>
                        Yes, Delete Account
                    </button>

                </form>

            </div>

        </div>
    </div>
</div>
