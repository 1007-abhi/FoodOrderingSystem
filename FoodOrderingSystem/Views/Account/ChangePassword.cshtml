@model FoodOrderingSystem.Dto.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="container py-5">

    ```
    <div class="row justify-content-center">

        <div class="col-12 col-md-8 col-lg-6">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-dark text-white text-center py-4">

                    <div class="mb-2">
                        <i class="bi bi-shield-lock-fill fs-1 text-warning"></i>
                    </div>

                    <h3 class="fw-bold mb-1">
                        Change Password
                    </h3>

                    <p class="text-secondary-emphasis text-white-50 mb-0">
                        Keep your account secure with a strong password
                    </p>

                </div>


                <!-- Body -->
                <div class="card-body p-4 p-md-5">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3"
                             role="alert">

                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["Success"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>

                        </div>
                    }


                    <form asp-action="ChangePassword" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger rounded-3">
                        </div>


                        <!-- Current Password -->
                        <div class="mb-4">

                            <label asp-for="CurrentPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-lock"></i>
                                </span>

                                <input asp-for="CurrentPassword"
                                       type="password"
                                       class="form-control form-control-lg"
                                       placeholder="Current password" />

                            </div>

                            <span asp-validation-for="CurrentPassword"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- New Password -->
                        <div class="mb-4">

                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-key"></i>
                                </span>

                                <input asp-for="NewPassword"
                                       type="password"
                                       class="form-control form-control-lg"
                                       placeholder="New password" />

                            </div>

                            <span asp-validation-for="NewPassword"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Password Requirements -->
                        <div class="alert alert-light border rounded-3 mb-4">

                            <h6 class="fw-bold mb-3">
                                <i class="bi bi-info-circle text-warning me-2"></i>
                                Password Requirements
                            </h6>

                            <div class="row g-2 small text-muted">

                                <div class="col-6">
                                    <i class="bi bi-check2-circle text-success me-1"></i>
                                    Minimum 8 characters
                                </div>

                                <div class="col-6">
                                    <i class="bi bi-check2-circle text-success me-1"></i>
                                    Uppercase letter
                                </div>

                                <div class="col-6">
                                    <i class="bi bi-check2-circle text-success me-1"></i>
                                    One number
                                </div>

                                <div class="col-6">
                                    <i class="bi bi-check2-circle text-success me-1"></i>
                                    Special character
                                </div>

                            </div>

                        </div>


                        <!-- Confirm Password -->
                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-shield-check"></i>
                                </span>

                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control form-control-lg"
                                       placeholder="Confirm new password" />

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Security Message -->
                        <div class="alert alert-warning border-0 rounded-3">

                            <div class="d-flex align-items-center">

                                <i class="bi bi-shield-check fs-4 me-3"></i>

                                <small>
                                    Choose a unique password that you don't use
                                    on other websites.
                                </small>

                            </div>

                        </div>


                        <!-- Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4">

                            <a asp-controller="Account"
                               asp-action="Profile"
                               class="btn btn-outline-secondary btn-lg px-4">

                                <i class="bi bi-arrow-left me-2"></i>
                                Back to Profile

                            </a>

                            <button type="submit"
                                    class="btn btn-warning btn-lg px-4 fw-semibold">

                                <i class="bi bi-lock-fill me-2"></i>
                                Change Password

                            </button>

                        </div>

                    </form>

                </div>

            </div>

            <!-- Bottom Security Text -->
            <div class="text-center text-muted mt-3">

                <small>
                    <i class="bi bi-shield-check me-1"></i>
                    Your password is protected and secure
                </small>

            </div>

        </div>

    </div>
    

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
