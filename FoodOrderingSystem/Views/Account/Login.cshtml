@model FoodOrderingSystem.Dto.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="bg-light min-vh-100 d-flex align-items-center py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-10 col-lg-11">

                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                    <div class="row g-0">

                        <!-- =========================
                             LEFT FOOD SECTION
                        ========================== -->
                        <div class="col-lg-6 d-none d-lg-flex">

                            <div class="w-100 bg-dark text-white p-5
                                        d-flex flex-column justify-content-center
                                        position-relative overflow-hidden">

                                <!-- Background Image -->
                                <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1000&q=85"
                                     class="position-absolute top-0 start-0 w-100 h-100"
                                     style="object-fit:cover; opacity:.35;"
                                     alt="Delicious Food">

                                <!-- Overlay -->
                                <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark"
                                     style="opacity:.60;">
                                </div>


                                <!-- Content -->
                                <div class="position-relative">

                                    <span class="badge bg-danger rounded-pill px-3 py-2 mb-4">

                                        <i class="bi bi-stars me-1"></i>
                                        Fresh & Delicious

                                    </span>


                                    <h1 class="display-5 fw-bold mb-4">

                                        Welcome
                                        <span class="text-danger">
                                            Back!
                                        </span>

                                    </h1>


                                    <p class="lead text-white-50 mb-5">

                                        Login to your account and continue
                                        ordering your favorite meals from
                                        the best restaurants.

                                    </p>


                                    <!-- Feature 1 -->
                                    <div class="d-flex align-items-center mb-4">

                                        <div class="bg-danger rounded-circle
                                                    d-flex align-items-center
                                                    justify-content-center me-3"
                                             style="width:50px;height:50px;">

                                            <i class="bi bi-lightning-charge-fill"></i>

                                        </div>

                                        <div>

                                            <h6 class="fw-bold mb-0">
                                                Fast Delivery
                                            </h6>

                                            <small class="text-white-50">
                                                Hot food delivered quickly
                                            </small>

                                        </div>

                                    </div>


                                    <!-- Feature 2 -->
                                    <div class="d-flex align-items-center mb-4">

                                        <div class="bg-danger rounded-circle
                                                    d-flex align-items-center
                                                    justify-content-center me-3"
                                             style="width:50px;height:50px;">

                                            <i class="bi bi-basket2-fill"></i>

                                        </div>

                                        <div>

                                            <h6 class="fw-bold mb-0">
                                                Fresh Food
                                            </h6>

                                            <small class="text-white-50">
                                                Delicious meals prepared fresh
                                            </small>

                                        </div>

                                    </div>


                                    <!-- Feature 3 -->
                                    <div class="d-flex align-items-center">

                                        <div class="bg-danger rounded-circle
                                                    d-flex align-items-center
                                                    justify-content-center me-3"
                                             style="width:50px;height:50px;">

                                            <i class="bi bi-heart-fill"></i>

                                        </div>

                                        <div>

                                            <h6 class="fw-bold mb-0">
                                                Made With Love
                                            </h6>

                                            <small class="text-white-50">
                                                Your favorite food, your way
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =========================
                             LOGIN FORM
                        ========================== -->
                        <div class="col-lg-6">

                            <div class="card-body p-4 p-md-5">

                                <!-- Login Header -->
                                <div class="text-center mb-4">

                                    <div class="bg-danger bg-opacity-10
                                                text-danger rounded-circle
                                                d-flex align-items-center
                                                justify-content-center
                                                mx-auto mb-3"
                                         style="width:70px;height:70px;">

                                        <i class="bi bi-person-fill-lock fs-2"></i>

                                    </div>


                                    <h2 class="fw-bold mb-2">
                                        Welcome Back
                                    </h2>

                                    <p class="text-muted">
                                        Login to continue ordering delicious food
                                    </p>

                                </div>


                                <!-- Login Form -->
                                <form asp-action="Login" method="post">

                                    <!-- Validation -->
                                    <div asp-validation-summary="ModelOnly"
                                         class="alert alert-danger"
                                         role="alert">
                                    </div>


                                    <!-- Username -->
                                    <div class="mb-4">

                                        <label asp-for="Username"
                                               class="form-label fw-semibold">

                                            Username

                                        </label>

                                        <div class="input-group">

                                            <span class="input-group-text bg-light">

                                                <i class="bi bi-person text-danger"></i>

                                            </span>

                                            <input asp-for="Username"
                                                   class="form-control form-control-lg"
                                                   placeholder="Enter your username"
                                                   autocomplete="username" />

                                        </div>

                                        <span asp-validation-for="Username"
                                              class="text-danger small">
                                        </span>

                                    </div>


                                    <!-- Password -->
                                    <div class="mb-3">

                                        <div class="d-flex justify-content-between">

                                            <label asp-for="Password"
                                                   class="form-label fw-semibold">

                                                Password

                                            </label>

                                            <a href="#"
                                               class="text-danger small text-decoration-none">

                                                Forgot Password?

                                            </a>

                                        </div>


                                        <div class="input-group">

                                            <span class="input-group-text bg-light">

                                                <i class="bi bi-lock text-danger"></i>

                                            </span>

                                            <input asp-for="Password"
                                                   type="password"
                                                   class="form-control form-control-lg"
                                                   id="loginPassword"
                                                   placeholder="Enter your password"
                                                   autocomplete="current-password" />

                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    onclick="toggleLoginPassword()">

                                                <i id="loginPasswordIcon"
                                                   class="bi bi-eye">
                                                </i>

                                            </button>

                                        </div>

                                        <span asp-validation-for="Password"
                                              class="text-danger small">
                                        </span>

                                    </div>


                                    <!-- Remember Me -->
                                    <div class="d-flex justify-content-between align-items-center mb-4">

                                        <div class="form-check">

                                            <input asp-for="RememberMe"
                                                   class="form-check-input"
                                                   id="rememberMe" />

                                            <label asp-for="RememberMe"
                                                   class="form-check-label text-muted"
                                                   for="rememberMe">

                                                Remember me

                                            </label>

                                        </div>

                                    </div>


                                    <!-- Login Button -->
                                    <button type="submit"
                                            class="btn btn-danger btn-lg w-100 rounded-pill fw-semibold">

                                        <i class="bi bi-box-arrow-in-right me-2"></i>

                                        Login

                                    </button>


                                    <!-- Divider -->
                                    <div class="d-flex align-items-center my-4">

                                        <hr class="flex-grow-1">

                                        <span class="px-3 text-muted small">
                                            OR
                                        </span>

                                        <hr class="flex-grow-1">

                                    </div>


                                    <!-- Register -->
                                    <div class="text-center">

                                        <p class="text-muted mb-2">
                                            Don't have an account?
                                        </p>

                                        <a asp-controller="Account"
                                           asp-action="Register"
                                           class="btn btn-outline-danger rounded-pill px-5">

                                            <i class="bi bi-person-plus me-2"></i>
                                            Create Account

                                        </a>

                                    </div>

                                </form>


                                <!-- Security Info -->
                                <div class="text-center mt-4">

                                    <small class="text-muted">

                                        <i class="bi bi-shield-lock-fill text-success me-1"></i>

                                        Your information is safe and secure

                                    </small>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================
     PASSWORD TOGGLE
========================= -->
<script>

    function toggleLoginPassword() {

        const password =
            document.getElementById("loginPassword");

        const icon =
            document.getElementById("loginPasswordIcon");


        if (password.type === "password") {

            password.type = "text";

            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash");

        }
        else {

            password.type = "password";

            icon.classList.remove("bi-eye-slash");
            icon.classList.add("bi-eye");

        }

    }

</script>
