<!-- Featured Items -->
<section id="featured" class="container py-5">

    <div class="text-center mb-5">

        <span class="text-danger fw-bold">
            OUR MENU
        </span>

        <h2 class="display-6 fw-bold mt-2">
            Popular Dishes
        </h2>

        <p class="text-muted">
            Hand-picked favorites our customers love
        </p>

    </div>


    <div class="row g-4" id="menu">

        @foreach (var item in Model)
        {
            <div class="col-xl-4 col-lg-4 col-md-6">

                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                    <!-- Food Image -->
                    <div class="position-relative">

                        <img src="@item.ImageUrl"
                             class="card-img-top"
                             alt="@item.Name"
                             style="height:230px;object-fit:cover;">

                        <!-- Popular Badge -->
                        <span class="position-absolute top-0 start-0 m-3 badge bg-danger rounded-pill px-3 py-2">
                            <i class="bi bi-fire"></i>
                            Popular
                        </span>

                        <!-- Rating -->
                        <span class="position-absolute bottom-0 end-0 m-3 badge bg-white text-dark rounded-pill px-3 py-2 shadow-sm">

                            <i class="bi bi-star-fill text-warning"></i>
                            4.8

                        </span>

                    </div>


                    <!-- Card Body -->
                    <div class="card-body p-4">

                        <h5 class="card-title fw-bold">
                            @item.Name
                        </h5>

                        <p class="card-text text-muted">
                            @item.Description
                        </p>


                        <div class="d-flex justify-content-between align-items-center mt-4">

                            <span class="fs-4 fw-bold text-danger">
                                ₹@item.Price
                            </span>

                            <a href="/Order/AddToCart?foodItemId=@item.Id" class="btn btn-primary">
    <i class="bi bi-cart-plus"></i> Add to Cart
</a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</section>


<!-- Why Choose Us -->
<section class="bg-light py-5">

    <div class="container">

        <div class="text-center mb-5">

            <span class="text-danger fw-bold">
