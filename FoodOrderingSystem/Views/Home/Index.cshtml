@model List<FoodItem>

@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="bg-dark text-white position-relative overflow-hidden">
    <div class="container py-5">
        <div class="row align-items-center min-vh-75">

            <div class="col-lg-7 py-5">

                <span class="badge bg-danger rounded-pill px-3 py-2 mb-3">
                    <i class="bi bi-stars"></i> Fresh & Delicious
                </span>

                <h1 class="display-3 fw-bold mb-4">
                    Delicious Food
                    <span class="text-danger">Delivered</span>
                    To Your Door
                </h1>

                <p class="lead text-light mb-4">
                    Order your favorite meals from the best restaurants
                    and enjoy fast delivery right to your doorstep.
                </p>

                <div class="d-flex gap-3 flex-wrap">

                    <a asp-controller="Menu"
   asp-action="Index"
                       class="btn btn-danger btn-lg rounded-pill px-4">
                        <i class="bi bi-bag-check me-2"></i>
                        Order Now
                    </a>

                   <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-light btn-lg rounded-pill px-4">

    Explore Menu
    <i class="bi bi-arrow-right ms-2"></i>

</a>

                </div>

            </div>

            <div class="col-lg-5 text-center d-none d-lg-block">

                <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=800&q=80"
                     class="img-fluid rounded-circle shadow-lg"
                     style="width:420px;height:420px;object-fit:cover;"
                     alt="Delicious Food">

            </div>

        </div>
    </div>
</section>


